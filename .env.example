# SIGAP - kmipn-26-deno
# Copy this file to .env and fill in the values

# ─── Agent / Outbox tuning ────────────────────────────
TOOL_TIMEOUT_MS=30000
MAX_RETRIES=2
MAX_ITERATIONS=10
LOCATION_TOLERANCE_METERS=100
TIME_TOLERANCE_HOURS=24
DUPLICATE_RADIUS_METERS=50
DUPLICATE_LIMIT=10
SLA_DEFAULT_DAYS=7
SHARE_TOKEN_EXPIRY_HOURS=168
OUTBOX_MAX_RETRIES=5
OUTBOX_RETRY_DELAYS_MINUTES=1,5,30,120,720
OUTBOX_BATCH_LIMIT=100
FAILED_ASSESSMENTS_BATCH_LIMIT=50
RETRY_MAX_ATTEMPTS=3
RETRY_BATCH_LIMIT=50
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ─── Outbox / Integrations ─────────────────────────────────────────────────
OUTBOUND_TARGETS={}
OUTBOUND_HMAC_SECRET=REPLACE_ME_RUN_openssl_rand_base64_32
OUTBOUND_HMAC_HEADER=X-SIGAP-Signature
SIPD_ENDPOINT_URL=https://sipd.REPLACE_ME.example.gov.id/api
SIPD_HMAC_SECRET=REPLACE_ME_RUN_openssl_rand_base64_32
SATU_DATA_ENDPOINT_URL=https://data.go.id/api
SATU_DATA_TOKEN=REPLACE_ME_BEARER_TOKEN

# ─── Webhook inbound ───────────────────────────────────────────────────────
WEBHOOK_SECRET=REPLACE_ME_RUN_openssl_rand_base64_32

# ─── App identity ─────────────────────────────────────────────────────────
APP_BASE_URL=https://sigap.live
CF_REPORTING_DOMAIN=sigap.live

# ─── Security toggles ──────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
DISABLE_LOGIN_AUDIT=false
ENVIRONMENT=production
RATE_LIMIT_BYPASS=false
ALLOWED_ORIGINS=https://admin.sigap.live,https://app.sigap.live

# ─── Captcha (Turnstile) ───────────────────────────────────────────────────
# Site key (frontend): 0x4AAAAAAETN7DX4_59Jd9Xw
# Secret key (backend): 0x4AAAAAAETN7KbHuaDXaLoATPejdz3T3Lc
CAPTCHA_SECRET=0x4AAAAAAETN7KbHuaDXaLoATPejdz3T3Lc
CAPTCHA_SITE_KEY=0x4AAAAAAETN7DX4_59Jd9Xw

# ─── Image uploads ──────────────────────────────────────────────────────────
ALLOWED_IMAGE_HOSTS=

# ─── Test/Reset (E2E testing) ─────────────────────────────────────────────
TEST_RESET_SECRET=your-test-reset-secret-here
ENABLE_TEST_RESET=false

# ─── LLM ───────────────────────────────────────────────────────────────────
TEXT_MODEL_NAME=MiniMax-M2.1
VISION_MODEL_NAME=MiniMax-M3
R2_PUBLIC_URL=https://kmipn-26-deno.r2.dev

# ─── Existing ──────────────────────────────────────────────────────────────
POSTGRESQL_URI=postgres://avnadmin:REPLACE_ME@HOST:PORT/defaultdb?sslmode=require
LLM_API_URI=https://api.minimax.io/v1
LLM_API_KEY=sk-cp-REPLACE_ME
JWT_SECRET=generate-with-openssl-rand-base64-32

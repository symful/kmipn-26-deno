# SIGAP - kmipn-26-deno
# Copy this file to .env and fill in the values

# ─── Agent / Outbox tuning ────────────────────────────
TOOL_TIMEOUT_MS=30000
MAX_RETRIES=2
MAX_ITERATIONS=10
LOCATION_TOLERANCE_METERS=100
TIME_TOLERANCE_HOURS=24
DUPLICATE_RADIUS_METERS=50
DUPLICATE_LIMIT=10
SLA_DEFAULT_DAYS=7
SHARE_TOKEN_EXPIRY_HOURS=168
FAILED_ASSESSMENTS_BATCH_LIMIT=50
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ─── App identity ─────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8787

# ─── Security toggles ──────────────────────────────────────────────────────
DISABLE_LOGIN_AUDIT=false
ENVIRONMENT=development
RATE_LIMIT_BYPASS=false
ALLOWED_ORIGINS=http://localhost:8787,http://localhost:5173

# ─── Captcha (Turnstile) ───────────────────────────────────────────────────
CAPTCHA_SECRET=replace_with_your_turnstile_secret

# ─── Image uploads ──────────────────────────────────────────────────────────
ALLOWED_IMAGE_HOSTS=


# ─── LLM ───────────────────────────────────────────────────────────────────
TEXT_MODEL_NAME=replace_with_supported_text_model
VISION_MODEL_NAME=replace_with_supported_vision_model
R2_PUBLIC_URL=https://r2.sigap.live

LLM_API_URI=https://your-provider.example/v1
LLM_API_KEY=replace_with_provider_secret
JWT_SECRET=generate-with-openssl-rand-base64-32

# Generate independently from JWT_SECRET; keep this key stable when rotating login secrets.
PHOTO_EVIDENCE_SECRET=replace_with_an_independent_random_secret

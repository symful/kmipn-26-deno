{
  "name": "sigap-kmipn-26-deno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm --prefix web run build && vite build && node --input-type=commonjs -e \"const fs=require('fs');const src='web/dist',dst='dist/client';fs.rmSync(dst,{recursive:true,force:true});fs.cpSync(src,dst,{recursive:true});console.log('Copied SPA to dist/client');\"",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --env-file=.env",
    "deploy:dryrun": "npm run build && wrangler deploy --dry-run --env-file=.env",
    "typecheck": "tsc --noEmit",
    "codegen": "tsx scripts/codegen.ts",
    "migrate": "tsx scripts/run_migrations.ts",
    "migrations:status": "tsx scripts/migrations_status.ts",
    "seed": "npm run migrate && tsx src/scripts/seed.ts",
    "seed:accounts": "tsx src/scripts/seed-accounts.ts",
    "seed:kpis": "tsx scripts/seed_phase_kpis.ts",
    "check:env": "tsx scripts/check_env.ts"
  },
  "dependencies": {
    "@cloudflare/workers-types": "4.20240815.0",
    "@vitejs/plugin-react": "^4.7.0",
    "bcryptjs": "2.4.3",
    "exifr": "7.1.3",
    "hono": "4.6.0",
    "jose": "5.9.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.13.0",
    "pg-cloudflare": "1.4.0",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@types/bcryptjs": "2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "20.16.0",
    "@types/pg": "8.11.10",
    "@types/ws": "8.5.12",
    "js-yaml": "^5.2.3",
    "tsx": "4.19.0",
    "typescript": "5.6.3",
    "vite": "^6.4.3",
    "wrangler": "4.120.0"
  }
}

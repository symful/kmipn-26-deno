{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kmipn-26-deno",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/r2/*"]
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "kmipn-26-deno",
      "preview_bucket_name": "kmipn-26-deno-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "kmipn-26-deno",
      "database_id": "3e3af215-7969-4a05-b26b-6b70face28d5"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMITER",
      "id": "cc37532524584f83af9cef7908d99134"
    }
  ],
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "vars": {
    "DISABLE_LOGIN_AUDIT": "false",
    "ENVIRONMENT": "production",
    "MAX_ITERATIONS": "10",
    "DEFAULT_PAGE_SIZE": "20",
    "MAX_PAGE_SIZE": "100",
    "RATE_LIMIT_BYPASS": "false",
    "ALLOWED_IMAGE_HOSTS": "",
    "SLA_DEFAULT_DAYS": "7",
    "TOOL_TIMEOUT_MS": "30000",
    "MAX_RETRIES": "2",
    "LOCATION_TOLERANCE_METERS": "100",
    "TIME_TOLERANCE_HOURS": "24",
    "DUPLICATE_RADIUS_METERS": "50",
    "DUPLICATE_LIMIT": "10",
    "SHARE_TOKEN_EXPIRY_HOURS": "168",
    "FAILED_ASSESSMENTS_BATCH_LIMIT": "50",
    "R2_PUBLIC_URL": "http://localhost:8787/r2",
    "ALLOWED_ORIGINS": "http://localhost:8787,http://localhost:5173"
  },
  "env": {
    "pilot-kabupaten-a": {
      "vars": {
        "WILAYAH_KABUPATEN_ID": "00000000-0000-0000-0000-000000000001",
        "DEPLOY_REGION": "kabupaten-a",
        "PILOT_NAME": "Pilot Kabupaten A"
      }
    },
    "pilot-kabupaten-b": {
      "vars": {
        "WILAYAH_KABUPATEN_ID": "00000000-0000-0000-0000-000000000002",
        "DEPLOY_REGION": "kabupaten-b",
        "PILOT_NAME": "Pilot Kabupaten B"
      }
    },
    "pilot-kabupaten-c": {
      "vars": {
        "WILAYAH_KABUPATEN_ID": "00000000-0000-0000-0000-000000000003",
        "DEPLOY_REGION": "kabupaten-c",
        "PILOT_NAME": "Pilot Kabupaten C"
      }
    }
  }
}
